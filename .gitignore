Records/
scratch/

# Rewritten from scratch on every launch (main.py opens it with mode="w"), so
# it only ever describes the last run on one machine.
app.log

# Claude Code: keep personal settings (settings.local.json and anything else)
# out of git, but track the project's own skills, commands and agents so they
# are backed up and exist on every clone, e.g. the lab PC.
.claude/*
!.claude/skills/
!.claude/commands/
!.claude/agents/

# Personal working notes, not project documentation. questions_for_vika.md was
# committed by accident on 2026-09-28 and had to be renamed and cleaned up;
# this is here so the same cannot happen to the editing log.
docs/english_editing_log.md

# The operator's last-used settings (todo.md B3). scos_config.json holds the
# committed defaults and is never written by the app.
scos_config.local.json
scos_config.local.json.tmp
